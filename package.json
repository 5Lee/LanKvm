{
  "name": "@local/dsh-lan-kvm",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Input-only software KVM: use this Mac keyboard and mouse on a LAN Windows PC, with no screen streaming.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "remote.js",
    "win-agent.ps1",
    "mac-helper.swift",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/dsh-plugin.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
